# Core Application Settings
PROJECT_NAME="DISASTERFOG AI Decision Support System"
API_V1_STR="/api"
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection (SQLite default, or PostgreSQL)
DATABASE_URL="sqlite:///./disasterfog.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/disasterfog"

# AI / LLM Configuration (Google Gemini)
# Obtain from https://aistudio.google.com/
LLM_API_KEY="AIzaSyYourGeminiApiKeyHere"
LLM_MODEL="gemini-1.5-flash"

# Mapping & Routing Provider Keys (Optional)
MAP_PROVIDER_KEY=""
